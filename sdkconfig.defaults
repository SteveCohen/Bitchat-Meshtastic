# ESP32-S3 sdkconfig overrides for Meshtastic-Bitchat bridge
#
# BLE (NimBLE) + WiFi run concurrently with Noise crypto — needs adequate
# stack/heap. The bridge runs both central and peripheral roles simultaneously.

# NimBLE host task stack: needs headroom for GATT client discovery, Noise
# DH + HKDF + ChaCha during handshake callbacks, and concurrent scan + connect.
# Default 4096 is far too small; 12288 gives comfortable margin.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=12288

# Enable both central and peripheral roles (NimBLE-Arduino 1.4 enables by
# default, but be explicit in case the default changes)
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y

# Allow up to 4 simultaneous BLE connections (central + peripheral combined)
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=4

# Increase ATT MTU to match BITCHAT_BLE_MTU (512)
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512

# Main app task stack: loop() calls BLE processing + bridge relay + crypto.
# 16384 gives safe margin for the static 2048-byte packet buffers + crypto.
CONFIG_ARDUINO_LOOP_STACK_SIZE=16384

# mbedtls: enable ChaCha20-Poly1305 AEAD (required for Noise ChaChaPoly)
CONFIG_MBEDTLS_CHACHAPOLY_C=y

# mbedtls: enable HKDF (required for Noise MixKey / Split)
CONFIG_MBEDTLS_HKDF_C=y

# mbedtls: enable Curve25519 (required for Noise DH)
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=y
